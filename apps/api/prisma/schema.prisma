// Schéma de la base de données (Prisma).
// Doc : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  watched      WatchedSymbol[]
  portfolios   Portfolio[]
}

// Portefeuille fictif d'un utilisateur (argent 100 % fictif).
model Portfolio {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  baseCurrency String   @default("USDT")
  initialCash  Decimal  @db.Decimal(24, 8)
  cash         Decimal  @db.Decimal(24, 8)
  feeRate      Decimal  @db.Decimal(10, 6)
  slippageBps  Int
  createdAt    DateTime @default(now())
}

// Une crypto suivie par un utilisateur (watchlist).
model WatchedSymbol {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

// Bougies de marché persistées (cache partagé : dashboard + workers/bots).
// Données de marché brutes → Float convient (le décimal est réservé à l'argent).
model Candle {
  symbol   String
  interval String
  openTime Int // début de bougie, en secondes UNIX
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float

  @@id([symbol, interval, openTime])
}
